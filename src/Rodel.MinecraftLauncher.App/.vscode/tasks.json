{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sprout: Build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}\\Rodel.MinecraftLauncher.App.csproj"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Sprout: Watch",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch",
        "--project",
        "${workspaceFolder}\\Rodel.MinecraftLauncher.App.csproj",
        "run"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Sprout: Publish Release",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}\\Rodel.MinecraftLauncher.App.csproj",
        "-c",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
